static uint8_t selected(const remote_status_model_t *model, remote_history_field_t field)
{
    uint8_t axis = remote_history_axis(field);
    if (axis) return remote_status_axis(model, (uint8_t)(axis - 1U));
    if (field == RH_DIFF || field == RH_AVERAGE ||
        (field >= RH_DELTA && field <= RH_CORRECTION) || field == RH_PAIR)
        return (uint8_t)(!model->received || (model->latest.axis_flags & 3U) == 3U);
    return 1U;
}

static uint8_t use(remote_display_t *display, const remote_status_model_t *model,
                    remote_history_field_t field, uint32_t now)
{
    const remote_history_value_t *value = &model->history[field];
    if (!selected(model, field)) return 0U;
    if (value->received) display->quality_any = 1U;
    if (!remote_history_fresh(model, field, now)) display->quality_old = 1U;
    return value->received;
}

static void format_number(char text[16], int32_t value, uint8_t decimal)
{
    uint32_t magnitude;
    if (!decimal) {
        (void)snprintf(text, 16U, "%ld", (long)value);
        return;
    }
    magnitude = value < 0 ? (uint32_t)(-(int64_t)value) : (uint32_t)value;
    (void)snprintf(text, 16U, "%s%lu.%lu", value < 0 ? "-" : "",
        (unsigned long)(magnitude / 10U), (unsigned long)(magnitude % 10U));
}

static uint8_t not_applicable(remote_display_t *display, const remote_status_model_t *model,
                              remote_history_field_t field, uint32_t now)
{
    if (field == RH_DIFF && remote_history_fresh(model, RH_AUTH, now) &&
        !(model->history[RH_AUTH].value & 2U)) { (void)use(display, model, RH_AUTH, now); return 1U; }
    if (field >= RH_DELTA && field <= RH_SYNC_AGE2 &&
        remote_history_fresh(model, RH_SYNC_FLAGS, now) &&
        !(model->history[RH_SYNC_FLAGS].value & 2U)) {
        (void)use(display, model, RH_SYNC_FLAGS, now); return 1U;
    }
    return 0U;
}
static void mark_stale(char text[16])
{
    size_t length=strlen(text);
    if(length<14U){memmove(text+1,text,length);text[0]='\x1F';text[length+1U]='~';text[length+2U]=0;}
}
static void mark_old(const remote_display_t *display, const remote_status_model_t *model, remote_history_field_t field,
                     uint32_t now, char text[16])
{
    if (!remote_history_fresh(model, field, now) ||
        remote_status_link(model, now) != REMOTE_RETURN_ONLINE) {
        if(display->language==REMOTE_DISPLAY_CHINESE)mark_stale(text);
        else {size_t n=strlen(text);if(n<14U){text[n]='~';text[n+1U]=0;}}
    }
}
static void number(remote_display_t *display, const remote_status_model_t *model,
                    remote_history_field_t field, uint32_t now, uint8_t decimal,
                    char text[16])
{
    if (!selected(model, field)) strcpy(text, display->language==REMOTE_DISPLAY_CHINESE?"未选":"NC");
    else if (not_applicable(display, model, field, now)) strcpy(text, display->language==REMOTE_DISPLAY_CHINESE?"不适用":"N/A");
    else if (!use(display, model, field, now)) strcpy(text, "--");
    else { format_number(text, model->history[field].value, decimal); mark_old(display,model, field, now, text); }
}

static void velocity(remote_display_t *display, const remote_status_model_t *model,
                      remote_history_field_t field, uint32_t now, char text[16])
{
    int32_t value, tenths;
    if (!selected(model, field)) { strcpy(text, display->language==REMOTE_DISPLAY_CHINESE?"未选":"NC"); return; }
    if (!use(display, model, field, now)) { strcpy(text, "--"); return; }
    value = model->history[field].value * 9;
    tenths = value < 0 ? -((-value + 125) / 250) : (value + 125) / 250;
    format_number(text, tenths, 1U);
    mark_old(display,model, field, now, text);
}

static void sample_age(remote_display_t *display, const remote_status_model_t *model,
                         remote_history_field_t field, uint32_t now, char text[16])
{
    uint32_t elapsed, age;
    number(display, model, field, now, 0U, text);
    if (!selected(model, field) || not_applicable(display, model, field, now) || !model->history[field].received) return;
    elapsed = now - model->history[field].updated_ms;
    age = (uint32_t)model->history[field].value;
    if (elapsed > UINT32_MAX - age) strcpy(text, display->language==REMOTE_DISPLAY_CHINESE?"溢出":"OVF");
    else (void)snprintf(text, 16U, "%lu", (unsigned long)(elapsed + age));
    mark_old(display,model, field, now, text);
}


static void rect(remote_display_t *d, uint8_t x, uint8_t y, uint8_t w, uint8_t h)
{
    remote_display_region_t *r;
    if (!w || d->region_count >= REMOTE_DISPLAY_REGIONS) { d->truncated = 1U; return; }
    r = &d->regions[d->region_count++]; r->x=x; r->y=y; r->width=w; r->height=h; r->underline=0U;
}
static void text(remote_display_t *d, uint8_t x, uint8_t y, uint8_t font,
                 uint8_t limit, const char *format, ...)
{
    /* '~' is an internal field delimiter only. Strip it and underline the
       preceding value, preserving its entire sign, precision and units. */
    static char buffer[REMOTE_DISPLAY_TEXT_BYTES];
    uint8_t starts[8], ends[8], spans=0U, out=0U, i=0U, begin=0U;
    uint16_t width; int count; va_list args; remote_display_item_t *item;
    va_start(args,format); count=vsnprintf(buffer,sizeof(buffer),format,args); va_end(args);
    if(count>=0 && count<(int)sizeof(buffer)) {
        while(buffer[i]) {
            if(buffer[i]=='\x1F') begin=out;
            else if(buffer[i]=='~') {
                if(begin<out && spans<8U){starts[spans]=begin;ends[spans++]=out;}
            } else buffer[out++]=buffer[i];
            i++;
        }
        buffer[out]=0;
    }
    width=count<0?129U:OLED_TextWidthUTF8(buffer,(uint16_t)strlen(buffer),font);
    if(count<0 || count>=(int)sizeof(buffer) || width>limit) {
        strcpy(buffer,"溢出"); width=font==OLED_UTF8_12X12?24U:32U; d->truncated=1U;spans=0U;
    }
    if(d->item_count>=REMOTE_DISPLAY_ITEMS) {d->truncated=1U;return;}
    item=&d->items[d->item_count++]; strcpy(item->text,buffer);
    item->x=x;item->y=y;item->width=(uint8_t)width;item->height=font==OLED_UTF8_12X12?12U:8U;item->font=font;
    for(i=0U;i<spans;i++) {
        uint8_t left=(uint8_t)OLED_TextWidthUTF8(buffer,starts[i],font);
        uint8_t right=(uint8_t)OLED_TextWidthUTF8(buffer,ends[i],font);
        if(d->region_count<REMOTE_DISPLAY_REGIONS) {
            rect(d,(uint8_t)(x+left),(uint8_t)(y+12U),(uint8_t)(right-left),1U);
            d->regions[d->region_count-1U].underline=1U;
        } else d->truncated=1U;
    }
}
static void row(remote_display_t *d,uint8_t n,const char *format,...)
{
    static char buffer[144]; va_list args; int count;
    va_start(args,format);count=vsnprintf(buffer,sizeof(buffer),format,args);va_end(args);
    if(count<0 || count>=(int)sizeof(buffer)){d->truncated=1U;return;}
    text(d,0U,(uint8_t)(12U+(n-1U)*13U),OLED_UTF8_12X12,128U,"%s",buffer);
}
static const char *bit(remote_display_t *d,const remote_status_model_t *m,
                       remote_history_field_t f,uint8_t mask,uint32_t now)
{
    if(!selected(m,f))return d->language==REMOTE_DISPLAY_CHINESE?"未选":"NC";
    if(!use(d,m,f,now))return "--";
    return (m->history[f].value & mask)?"1":"0";
}
static const char *named(remote_display_t *d,const remote_status_model_t *m,
                         remote_history_field_t f,const char *const *names,uint8_t n,uint32_t now)
{
    int32_t v=m->history[f].value;
    if(!use(d,m,f,now))return d->language==REMOTE_DISPLAY_CHINESE?"未知":"UNK";
    return v>=0 && v<n?names[v]:(d->language==REMOTE_DISPLAY_CHINESE?"未知":"UNK");
}
