static const char *radio_name(const char *s)
{
    if(!s)return "未知";
    if(!strcmp(s,"ID"))return rf_names[0];
    if(!strcmp(s,"BY"))return rf_names[1];
    if(!strcmp(s,"OK"))return rf_names[2];
    if(!strcmp(s,"MX"))return rf_names[3];
    return rf_names[4];
}
static const char *axes_name(const remote_status_model_t *m)
{ return !m->received?"未知":((m->latest.axis_flags&3U)==3U?"双轴":(m->latest.axis_flags&1U?"A1":(m->latest.axis_flags&2U?"A2":"未选"))); }
static void values(remote_display_t *d,const remote_status_model_t *m,uint32_t now,
                    uint8_t n,const char *label,remote_history_field_t f,uint8_t decimals,const char *unit)
{
    char a[16],b[16];number(d,m,f,now,decimals,a);number(d,m,(remote_history_field_t)(f+1),now,decimals,b);
    row(d,n,"%s%s/%s%s",label,a,b,unit);
}
static void age_text(const remote_status_model_t *m,remote_history_field_t f,uint32_t now,char t[16])
{ if(m->history[f].received)(void)snprintf(t,16U,"%lu",(unsigned long)(now-m->history[f].updated_ms));else strcpy(t,"--"); }
static void hex_number(remote_display_t *d,const remote_status_model_t *m,remote_history_field_t f,
                        uint32_t now,uint8_t digits,char t[16])
{
    number(d,m,f,now,0U,t);
    if(selected(m,f)&&m->history[f].received) {
        (void)snprintf(t,16U,digits==4U?"%04X":"%02X",(unsigned)m->history[f].value);
        mark_old(d,m,f,now,t);
    }
}
static unsigned key_code(const char keys[13])
{
    unsigned result=0U;uint8_t i;
    for(i=0U;i<12U && keys[i];i++)if(keys[i]=='1')result|=1U<<i;
    return result;
}
uint8_t remote_display_page_count(remote_display_language_t language)
{ return language==REMOTE_DISPLAY_CHINESE?REMOTE_DISPLAY_ZH_PAGE_COUNT:REMOTE_DISPLAY_EN_PAGE_COUNT; }
void remote_display_init(remote_display_t *d) {memset(d,0,sizeof(*d));}
void remote_display_keys(remote_display_t *d,uint16_t keys,uint16_t *s,uint16_t *l,uint16_t *b)
{
    uint16_t local=keys&REMOTE_LOCAL_KEY_MASK;
    uint8_t count=remote_display_page_count((remote_display_language_t)d->requested_language);
    /* Consume the existing one-shot K7 long event before filtering local bits.
       Requested state never changes the frozen snapshot currently on the wire. */
    if((*l&REMOTE_PREVIOUS_PAGE_KEY_MASK)!=0U) {
        d->requested_language=(uint8_t)(d->requested_language==REMOTE_DISPLAY_CHINESE?REMOTE_DISPLAY_ENGLISH:REMOTE_DISPLAY_CHINESE);
        d->requested_page=0U;
    } else if(local==REMOTE_PREVIOUS_PAGE_KEY_MASK)d->requested_page=(uint8_t)((d->requested_page+count-1U)%count);
    else if(local==REMOTE_NEXT_PAGE_KEY_MASK)d->requested_page=(uint8_t)((d->requested_page+1U)%count);
    *s&=(uint16_t)~REMOTE_LOCAL_KEY_MASK;*l&=(uint16_t)~REMOTE_LOCAL_KEY_MASK;*b&=(uint16_t)~REMOTE_LOCAL_KEY_MASK;
}

