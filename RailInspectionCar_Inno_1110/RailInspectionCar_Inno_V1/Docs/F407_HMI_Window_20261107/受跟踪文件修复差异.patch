+static void build_capabilities_window(const hmi_state_input_t *in,
+    const hmi_alarm_state_t *alarm, uint32_t read_ms, uint16_t *r)
+{
+    uint32_t sources = upper_sources(in), flags;
+    uint16_t caps = 0U, target0, target1;
+    const uint8_t *p;
+    uint8_t i, selected;
+    r[0xB0U] = 0xFFFFU; r[0xB1U] = 0xFFFFU;
+    r[0xB2U] = !in->can_valid || !in->can.enabled ? 0U :
+        can_session(in) ? 1U : in->can.bus.phase == BSP_CAN_BACKOFF ? 3U : 2U;
+    r[0xB3U] = (sources & ((1UL << 17U) | (1UL << 18U))) != 0U &&
+        (!(sources & (1UL << 17U)) || upper_valid(in, 3U)) &&
+        (!(sources & (1UL << 18U)) || upper_valid(in, 5U));
+    put32(r, 0xB4U, in->sequence);
+    if (in->can_valid && in->can.enabled && in->can.task_created) caps |= 1U << 10U;
+    if (sources & (1UL << 17U))
+    {
+        caps |= 1U << 9U; r[0xB1U] = 0xFFFFU;
+        if (upper_valid(in, 3U))
+        {
+            p = in->upper[3].payload;
+            if (p[20] == 0U) r[0xB1U] = 0U;
+            else if (p[20] != 255U && (p[23] & 1U))
+                r[0xB1U] = p[21] == 5U || le32(p + 24U) ? 3U :
+                    le32(p + 8U) == 0U ? 2U : 1U;
+        }
+    }
+    if (sources & (1UL << 18U))
+    {
+        caps |= 1U << 8U; r[0xB0U] = 0xFFFFU;
+        if (upper_valid(in, 5U))
+        {
+            p = in->upper[5].payload; flags = le32(p + 28U);
+            if ((flags & 16U) && le32(p + 20U)) r[0xB0U] = 3U;
+            else if (flags & 1U) r[0xB0U] = (flags & 6U) ? 2U : 1U;
+        }
+    }
+    if (((sources & (1UL << 17U)) && r[0xB1U] == 0xFFFFU) ||
+        ((sources & (1UL << 18U)) && r[0xB0U] == 0xFFFFU)) r[0xB3U] = 0U;
+    if (sources & (1UL << 16U)) caps |= 1U << 7U;
+    if (sources & (1UL << 15U)) caps |= 1U << 4U;
+    if ((sources & (1UL << 25U)) &&
+        (le32(in->upper[0].payload + 12U) & (1UL << 25U))) caps |= 1U << 5U;
+    r[0xC3U] = in->position_valid ? (uint16_t)in->position.lost_intervals : 0U;
+    for (i = 0U; i < 2U; ++i)
+    {
+        const servo_snapshot_t *a = &in->axis[i];
+        selected = (in->selected & (1U << i)) != 0U;
+        r[0xC4U + i] = selected && in->axes_valid ?
+            (speed_valid(in, i) ? 1U : 0U) | (fault_valid(in, i) ? 2U : 0U) |
+            (speed_valid(in, i) && !a->actual_speed_rpm ? 4U : 0U) : 0xFFFFU;
+        r[0xC6U + i] = selected && in->axes_valid ? age16(a->speed_age_ms) : 0xFFFFU;
+        r[0xC8U + i] = selected && in->axes_valid ? (uint16_t)a->poll_failures : 0U;
+    }
+    if (APP_POSITION_MONITOR_ENABLED) caps |= 1U;
+    if (in->selected == 3U) caps |= 2U;
+    caps |= 4U | (1U << 11U) | (1U << 12U);
+    r[0xC0U] = 0x5249U; r[0xC1U] = 1U; r[0xC2U] = caps;
+    target0 = axis_command(in, 0U); target1 = axis_command(in, 1U);
+    r[0xCAU] = in->selected == 1U ? target0 : in->selected == 2U ? target1 :
+        target0 != 0x7FFFU && target1 != 0x7FFFU ? signed16(((int16_t)target0 + (int16_t)target1) / 2.0) : 0x7FFFU;
+    r[0xCBU] = in->owner_valid ? owner_code(in->owner) : 0xFFFFU; r[0xCCU] = APP_HMI_CONTROL_ENABLED && (in->hmi_control.flags & 2U) ? 1U : 0U;
+    r[0xCEU] = in->axes_valid && in->health_valid && in->position_valid;
+    r[0xCFU] = in->owner_valid && in->remote_valid && in->cli_valid && in->debug_valid && in->k1_valid;
+    r[0xCDU] = alarm_level(alarm, read_ms);
+}
+
+static void build_metadata_window(const hmi_state_input_t *in, uint16_t *r)
+{
+    r[0x200U] = 0x5249U; r[0x201U] = 1U;
+    r[0x202U] = APP_HMI_CONTROL_ENABLED ? 255U : 1U;
+    r[0x203U] = APP_HMI_DICTIONARY_REVISION;
+    put32(r, 0x204U, in->identity_valid ? in->boot_id : 0xFFFFFFFFUL); put32(r, 0x206U, in->sequence);
+    put32(r, 0x208U, in->now_ms); r[0x20AU] = APP_HMI_SNAPSHOT_PERIOD_MS;
+    r[0x20BU] = APP_HMI_FW_PATCH; put32(r, 0x20CU, in->reset_reason);
+    put32(r, 0x20EU, APP_HMI_CONTROL_ENABLED ? in->hmi_session : 0U);
+    r[0x210U] = in->owner_valid ? owner_code(in->owner) : 0xFFFFU;
+    r[0x211U] = APP_HMI_CONTROL_ENABLED ? in->lock_reason : 1U;
+    r[0x212U] = APP_HMI_CONTROL_ENABLED ? in->hmi_age : 0xFFFFU;
+    r[0x213U] = APP_HMI_CONTROL_ENABLED ? in->hmi_remaining : 0U;
+    r[0x214U] = APP_HMI_CONTROL_ENABLED ? in->selected : 0U;
+    r[0x215U] = APP_HMI_CONTROL_ENABLED ? (uint16_t)APP_OPERATION_MAX_VELOCITY_MM_S : 0U;
+    r[0x216U] = APP_HMI_CONTROL_ENABLED ? APP_HMI_SESSION_LEASE_MS : 0U;
+}
+
+/* Each half of a 32-bit detail is independently bounded by the request. */
+static void window_put16(uint16_t *r, uint16_t start, uint16_t end,
+    uint16_t address, uint16_t value)
+{
+    if (address >= start && address <= end) r[address] = value;
+}
+
+static void window_put32(uint16_t *r, uint16_t start, uint16_t end,
+    uint16_t address, uint32_t value)
+{
+    window_put16(r, start, end, address, (uint16_t)(value >> 16U));
+    window_put16(r, start, end, (uint16_t)(address + 1U), (uint16_t)value);
+}
+
+static void build_details_window(const hmi_state_input_t *in, uint16_t start,
+    uint16_t end, uint16_t *r)
+{
+    unsigned i, word;
+    uint16_t a;
+    if (start <= 0x32FU)
+    {
+        window_put16(r, start, end, 0x300U, 0x5249U); window_put16(r, start, end, 0x301U, 1U);
+        window_put32(r, start, end, 0x302U, in->boot_id); window_put32(r, start, end, 0x304U, in->sequence);
+        window_put32(r, start, end, 0x306U, in->now_ms);
+        window_put16(r, start, end, 0x308U, in->selected); window_put16(r, start, end, 0x309U, owner_code(in->owner));
+        window_put16(r, start, end, 0x30AU, in->can_valid ? (uint16_t)in->can.bus.phase : 0xFFFFU);
+        window_put16(r, start, end, 0x30BU, in->can_valid ? (uint16_t)in->can.phase : 0xFFFFU);
+        window_put32(r, start, end, 0x30CU, in->can_valid ? in->can.upper_boot_id : 0U);
+        window_put32(r, start, end, 0x30EU, in->can_valid ? in->can.generation : 0U);
+        window_put32(r, start, end, 0x310U, in->can_valid ? in->can.bus.rx_count : 0U);
+        window_put32(r, start, end, 0x312U, in->can_valid ? in->can.bus.tx_success : 0U);
+        window_put32(r, start, end, 0x314U, in->can_valid ? in->can.bus.tx_failed : 0U);
+        window_put32(r, start, end, 0x316U, in->can_valid ? in->can.bus.bus_off_count : 0U);
+        window_put32(r, start, end, 0x318U, in->can_valid ? in->can.upper_invalid : 0U);
+        window_put16(r, start, end, 0x31AU, in->can_valid ? age16(in->now_ms - in->can.last_service_ms) : 0xFFFFU);
+        window_put16(r, start, end, 0x31BU, age16(in->heartbeat_ms[3]));
+        window_put16(r, start, end, 0x31CU, in->can_valid ? 1U : 0U);
+        window_put16(r, start, end, 0x31DU, 0U); /* 无实体DI3、STO、制动反馈能力。 */
+
+        window_put16(r, start, end, 0x31EU, in->remote_valid ? in->remote.controlled_stop_reason : 0xFFFFU);
+        window_put16(r, start, end, 0x31FU, in->remote_valid ? in->remote.controlled_stop_state : 0xFFFFU);
+        window_put16(r, start, end, 0x320U, in->remote_valid ? in->remote.stop_zero_mask : 0U);
+        window_put16(r, start, end, 0x321U, in->k1.state);
+        window_put16(r, start, end, 0x322U, in->k1.valid); window_put16(r, start, end, 0x323U, in->k1.confirmed_mask);
+        window_put32(r, start, end, 0x324U, in->remote.stop_elapsed_ms);
+        window_put32(r, start, end, 0x326U, in->remote.stop_timeout_ms);
+        window_put32(r, start, end, 0x328U, in->remote.stop_first_command_valid ? in->remote.stop_first_command_ms : UINT32_MAX);
+        window_put32(r, start, end, 0x32AU, in->remote.stop_zero_time_valid ? in->remote.stop_zero_ms : UINT32_MAX);
+        window_put32(r, start, end, 0x32CU, in->remote.stop_complete_time_valid ? in->remote.stop_complete_ms : UINT32_MAX);
+        window_put16(r, start, end, 0x32EU, in->cli_valid ? in->cli.state : 0xFFFFU);
+        window_put16(r, start, end, 0x32FU, in->cli_valid ? in->cli.reason : 0xFFFFU);
+    }
+    if (start <= 0x33FU && end >= 0x330U)
+    {
+        for (i = 0U; i < 2U; i++)
+        {
+            a = (uint16_t)(0x330U + 8U * i);
+            if (a > end || a + 7U < start) continue;
+            window_put16(r, start, end, a, in->startup_valid ? in->startup[i].state : 0xFFFFU);
+            window_put16(r, start, end, a + 1U, in->startup_valid ? in->hold[i].state : 0xFFFFU);
+            window_put16(r, start, end, a + 2U, in->startup_valid ? in->watchdog[i].state : 0xFFFFU);
+            window_put16(r, start, end, a + 3U, in->startup_valid ? in->watchdog[i].failure_reason : 0xFFFFU);
+            window_put16(r, start, end, a + 4U, in->startup_valid ? in->watchdog[i].zero_samples : 0U);
+            window_put16(r, start, end, a + 5U, in->startup_valid ? in->watchdog[i].decel_readback_ms : 0xFFFFU);
+            window_put16(r, start, end, a + 6U, in->startup_valid ? (uint16_t)in->watchdog[i].start_speed_rpm : 0x7FFFU);
+            window_put16(r, start, end, a + 7U, in->startup_valid ? in->boot_zero[i].state : 0xFFFFU);
+        }
+    }
+    if (start <= 0x35FU && end >= 0x340U)
+    {
+        window_put16(r, start, end, 0x340U, in->position_valid ? in->position.state : 0xFFFFU);
+        window_put16(r, start, end, 0x341U, in->position_valid && in->position.pair_valid);
+        window_put16(r, start, end, 0x342U, in->position_valid && in->position.vehicle_valid);
+        window_put16(r, start, end, 0x343U, in->position_valid ? in->position.source_mask : 0U);
+        window_put32(r, start, end, 0x344U, in->position.baseline_generation);
+        window_put32(r, start, end, 0x346U, in->position.lost_intervals);
+        window_put32(r, start, end, 0x348U, in->position.pair_age_ms);
+        window_put16(r, start, end, 0x34AU, in->position_valid ? in->position.axis[0].state : 0xFFFFU);
+        window_put16(r, start, end, 0x34BU, in->position_valid ? in->position.axis[1].state : 0xFFFFU);
+        window_put16(r, start, end, 0x34CU, in->position_valid ? in->position.axis[0].incomplete : 0U);
+        window_put16(r, start, end, 0x34DU, in->position_valid ? in->position.axis[1].incomplete : 0U);
+        window_put32(r, start, end, 0x34EU, in->axes_valid ? in->axis[0].position_sequence : 0U);
+        window_put32(r, start, end, 0x350U, in->axes_valid ? in->axis[1].position_sequence : 0U);
+        window_put32(r, start, end, 0x352U, in->axes_valid ? in->axis[0].position_age_ms : UINT32_MAX);
+        window_put32(r, start, end, 0x354U, in->axes_valid ? in->axis[1].position_age_ms : UINT32_MAX);
+        window_put16(r, start, end, 0x356U, in->position_valid);
+        window_put16(r, start, end, 0x357U, 0U); /* 未实现告警历史，不声明历史能力。 */
+
+        window_put16(r, start, end, 0x358U, in->remote_valid ? in->remote.authorized : 0U);
+        window_put16(r, start, end, 0x359U, in->cli_valid ? in->cli.authorized : 0U);
+        window_put32(r, start, end, 0x35AU, in->cli_valid ? in->cli.session_id : 0U);
+        window_put16(r, start, end, 0x35CU, in->axes_valid ? age16(in->axis[0].fault_age_ms) : 0xFFFFU);
+        window_put16(r, start, end, 0x35DU, in->axes_valid ? age16(in->axis[1].fault_age_ms) : 0xFFFFU);
+        window_put16(r, start, end, 0x35EU, in->remote_valid ? in->remote.estop_latched : 0xFFFFU);
+        window_put16(r, start, end, 0x35FU, in->init_complete);
+    }
+    /* 扩展区保存规范化的原CAN记录；不以半条记录或过期载荷刷新有效性。 */
+    if (end >= 0x360U)
+    {
+        for (i = 0U; i < HMI_UPPER_COUNT; i++)
+        {
+            const can_upper_snapshot_t *u = &in->upper[i];
+            a = (uint16_t)(0x360U + 32U * i);
+            if (a > end || a + 31U < start) continue;
+            window_put16(r, start, end, a, i == 0U ? 2U : (uint16_t)(0x3FU + i));
+            window_put16(r, start, end, a + 1U, u->present);
+            window_put16(r, start, end, a + 2U, upper_valid(in, (uint8_t)i));
+            window_put16(r, start, end, a + 3U, u->present ? u->length : 0U);
+            window_put16(r, start, end, a + 4U, u->sequence);
+            window_put16(r, start, end, a + 5U, u->present ? age16(u->age_ms) : 0xFFFFU);
+            window_put32(r, start, end, (uint16_t)(a + 6U), u->present ? u->received_ms : UINT32_MAX);
+            for (word = 0U; word < 24U; word++)
+                if (a + 8U + word >= start && a + 8U + word <= end)
+                    window_put16(r, start, end, a + 8U + word, u->present && word * 2U + 1U < u->length ?
+                        le16(u->payload + word * 2U) : 0xFFFFU);
+        }
+    }
+}
+
+/* Reuses the existing absolute-address scratch. No request consumes old
+ * scratch, observes an alarm, or touches a bus/motion service. */
+uint8_t app_hmi_state_build_window(const hmi_state_input_t *in,
+    const hmi_alarm_state_t *alarm, uint32_t read_ms,
+    uint16_t start, uint16_t quantity, uint16_t r[HMI_STATE_REGISTER_COUNT])
+{
+    uint32_t last;
+    uint16_t first, count;
+    uint8_t window;
+    if (in == NULL || alarm == NULL || r == NULL || quantity == 0U || quantity > 125U)
+        return 0U;
+    last = (uint32_t)start + quantity - 1U;
+    if (start <= 0x003FU && last <= 0x003FU)
+    {
+        first = 0x0000U; count = 64U; window = 0U;
+    }
+    else if (start >= 0x0050U && last <= 0x006FU)
+    {
+        first = 0x0050U; count = 32U; window = 1U;
+    }
+    else if (start >= 0x0070U && last <= 0x008FU)
+    {
+        first = 0x0070U; count = 32U; window = 2U;
+    }
+    else if (start >= 0x0090U && last <= 0x00AFU)
+    {
+        first = 0x0090U; count = 32U; window = 3U;
+    }
+    else if (start >= 0x00B0U && last <= 0x00CFU)
+    {
+        first = 0x00B0U; count = 32U; window = 4U;
+    }
+    else if (start >= 0x0200U && last <= 0x0217U)
+    {
+        first = 0x0200U; count = 24U; window = 5U;
+    }
+    else if (start >= 0x0300U && last <= 0x045FU)
+    {
+        first = start; count = quantity; window = 6U;
+    }
+    else if (start >= HMI_CONTROL_REGISTER_START && last < HMI_STATE_REGISTER_COUNT)
+    {
+        first = HMI_CONTROL_REGISTER_START; count = HMI_CONTROL_REGISTER_COUNT; window = 7U;
+    }
+    else return 0U;
+    if (window == 7U)
+        app_hmi_state_build_control(in, &r[first]);
+    else
+    {
+        memset(&r[first], 0, count * sizeof(*r));
+        switch (window)
+        {
+            case 0U: build_basic_window(in, alarm, read_ms, r); break;
+            case 1U: build_communications_window(in, r); break;
+            case 2U: build_position(in, r); build_sync(in, r); break;
+            case 3U: build_upper_summary_window(in, alarm, read_ms, r); break;
+            case 4U: build_capabilities_window(in, alarm, read_ms, r); break;
+            case 5U: build_metadata_window(in, r); break;
+            default: build_details_window(in, start, (uint16_t)last, r); break;
+        }
+    }
+    return 1U;
+}
