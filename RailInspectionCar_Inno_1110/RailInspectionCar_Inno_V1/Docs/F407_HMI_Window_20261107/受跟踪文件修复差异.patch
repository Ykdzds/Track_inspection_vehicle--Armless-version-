+static void slow_wire_transaction(void)
+{
+    uint8_t frame[8];
+    uint32_t captured_cycles, source_sequence;
+    fresh(); captured_length = 0U;
+    request(frame, 0x0460U, 96U); inject(frame, sizeof(frame)); boundary();
+    captured_cycles = s_last_rx_cycles;
