diff --git a/Tests/test_dual_source_random.c b/Tests/test_dual_source_random.c
new file mode 100644
index 0000000..435c084
--- /dev/null
+++ b/Tests/test_dual_source_random.c
@@ -0,0 +1,67 @@
+/* Real source adapters, frequent updates and keepalive under serial writes. */
+#include <stdint.h>
+#define NORMAL_TIMING_TEST 1
+#define main fixture_regression_main
+#if TIMING_SOURCE == 1
+#include "test_hmi_control.c"
+#elif TIMING_SOURCE == 2
+static uint32_t timing_delay,timing_due[2];
+static int16_t timing_rpm[2];
+#include "test_remote_servo.c"
+#else
+#include "test_can_control.c"
+#endif
+#undef main
+#include "app_normal_ramp.h"
+int main(void)
+{
+    unsigned step,axis;
+    app_normal_ramp_status_t before,after;
+#if TIMING_SOURCE == 1
+    uint16_t mailbox[24]; uint32_t session,sequence=1;
+    reset_fixture();g_feedback_progress=1;timing_delay=0;
+    make_mailbox(mailbox,TEST_CMD_ACQUIRE,0,sequence++,0,0);
+    submit_service(mailbox);session=app_hmi_control_session();assert(session);
+    for(step=0;step<20;++step){++g_tick;app_hmi_control_service();}
+    app_hmi_control_ramp_status(&before);
+#elif TIMING_SOURCE == 2
+    nrf_remote_snapshot_t input;
+    memset(axes,0,sizeof(axes));memset(&input,0,sizeof(input));memset(&debug,0,sizeof(debug));
+    hold_response=prepare_fail_mask=enable_fail_mask=startup_hold=0;hold_ready=boot_ready=1;timing_delay=0;
+    for(axis=0;axis<2;++axis){axes[axis].online=axes[axis].enabled=axes[axis].parameter_verified=1;axes[axis].control_mode=SERVO_CONTROL_RS485_VELOCITY;}
+    input.link_up=1;reset_remote();arm(&input);assert(status().authorized);
+    app_remote_servo_ramp_status(&before);
+#else
+    reset();acquire();timing_delay=0;
+    app_can_control_ramp_status(&before);
+#endif
+    timing_delay=60;
+    for(step=1;step<=5000;++step){
+        /* Nonlinear target sequence every 10ms; targets remain above ramp. */
+        int target=700+(int)((step/10*67U)%800U);
+#if TIMING_SOURCE == 1
+        ++g_tick;
+        if(step%10==0){make_mailbox(mailbox,TEST_CMD_SPEED,session,sequence++,target,500);submit_service(mailbox);}
+        else app_hmi_control_service();
+        assert(app_hmi_control_session()==session);
+#elif TIMING_SOURCE == 2
+        ++ticks;if(step%10==0)input.left_vertical=joystick_for_rpm(target);feed(&input);
+        assert(status().authorized);
+#else
+        if(step%10==0)assert(speed((int16_t)(target*app_can_control_rpm_mm_s(1,0)),300));
+        advance(1,true);assert(state.authorized);
+#endif
+    }
+#if TIMING_SOURCE == 1
+    app_hmi_control_ramp_status(&after);
+#elif TIMING_SOURCE == 2
+    app_remote_servo_ramp_status(&after);
+#else
+    app_can_control_ramp_status(&after);
+#endif
+    assert(after.dual.integrated_ms-before.dual.integrated_ms==5000);
+    assert(after.dual.discarded_ms==before.dual.discarded_ms);
+    for(axis=0;axis<2;++axis)assert(after.dual.planned_rpm[axis]>150 && after.dual.planned_rpm[axis]<240);
+    printf("PASS source=%u frequent nonlinear targets: 5000/5000ms integrated during 60ms serial writes\n",TIMING_SOURCE);
+    return 0;
+}
diff --git a/Tests/run_dual_axis_tests.ps1 b/Tests/run_dual_axis_tests.ps1
new file mode 100644
index 0000000..0f2da3d
--- /dev/null
+++ b/Tests/run_dual_axis_tests.ps1
@@ -0,0 +1,34 @@
+param([string]$Compiler='D:/Dev-C++软件--蓝桥杯比赛环境/Dev-Cpp/MinGW64/bin/gcc.exe', [string]$Output='')
+$ErrorActionPreference='Stop'
+Push-Location (Split-Path $PSScriptRoot -Parent)
+try {
+    $configs=@(
+        @('-DTEST_DUAL_CONFIG_VALID=1'),
+        @('-DTEST_DUAL_CONFIG_VALID=0','-DAPP_DUAL_S_ENABLED=1'),
+        @('-DTEST_DUAL_CONFIG_VALID=0','-DAPP_DUAL_PI_ENABLED=1'),
+        @('-DTEST_DUAL_CONFIG_VALID=0','-DAPP_DUAL_FRONT_GEAR=0.0f'),
+        @('-DTEST_DUAL_CONFIG_VALID=0','-DAPP_DUAL_REAR_SIGN=0'),
+        @('-DTEST_DUAL_CONFIG_VALID=0','-DAPP_DUAL_S_ENABLED=1','-DAPP_DUAL_JERK_MPS3=-0.4f'),
+        @('-DTEST_DUAL_CONFIG_VALID=1','-DAPP_DUAL_S_ENABLED=1','-DAPP_DUAL_JERK_MPS3=0.4f'),
+        @('-DTEST_DUAL_CONFIG_VALID=1','-DAPP_DUAL_PI_ENABLED=1','-DAPP_DUAL_KI=0.02f','-DAPP_DUAL_KAW=1.0f'))
+    foreach($config in $configs){
+        $configExe=Join-Path $env:TEMP 'dual_config.exe'
+        & $Compiler -std=c99 -Wall -Wextra -Werror -IAPP @config Tests/test_dual_config.c -o $configExe
+        if($LASTEXITCODE){throw 'Dual configuration compile failed'}
+        & $configExe
+        if($LASTEXITCODE){throw 'Dual configuration gate failed'}
+    }
+    foreach($variant in @(0,1,2,3)) {
+        $exe=Join-Path $env:TEMP "dual_axis_$variant.exe"
+        $argsList=@('-std=c99','-Wall','-Wextra','-Werror','-ITests/mocks','-IAPP','-IDevice',
+            'Tests/test_dual_axis_motion.c','APP/app_dual_axis_motion.c','APP/app_remote_servo_sync.c')
+        if($variant -eq 0){$argsList+='-DAPP_REMOTE_SERVO_SYNC_ENABLED=0'}
+        if($variant -ge 2){$argsList+=@('-DAPP_DUAL_S_ENABLED=1','-DAPP_DUAL_JERK_MPS3=0.4f')}
+        if($variant -eq 3){$argsList+=@('-DAPP_DUAL_PI_ENABLED=1','-DAPP_DUAL_KI=0.02f','-DAPP_DUAL_KAW=1.0f')}
+        & $Compiler @argsList -lm -o $exe
+        if($LASTEXITCODE){throw 'Dual-axis compile failed'}
+        if($Output){$env:DUAL_CURVE_FILE=Join-Path $Output "dynamic_model_$variant.csv"}
+        & $exe
+        if($LASTEXITCODE){throw "Dual-axis tests failed variant=$variant"}
+    }
+} finally { Remove-Item Env:DUAL_CURVE_FILE -ErrorAction SilentlyContinue; Pop-Location }
