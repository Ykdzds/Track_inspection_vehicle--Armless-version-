--- /dev/null
+++ b/Tests/run_hmi_snapshot_freshness_tests.ps1
@@ -0,0 +1,20 @@
+param([string]$Compiler = "D:\Dev-C++软件--蓝桥杯比赛环境\Dev-Cpp\MinGW64\bin\gcc.exe")
+$ErrorActionPreference = "Stop"
+$root = Split-Path $PSScriptRoot -Parent
+$binary = Join-Path $env:TEMP "rail_hmi_snapshot_freshness_tests.exe"
+Push-Location $root
+try {
+    foreach ($diag in @(0,1)) {
+        & $Compiler -std=c99 -Wall -Wextra -Werror -DportTICK_PERIOD_MS=1U `
+            -DAPP_CAN_CONTROL_ENABLED=0 -DAPP_CAN_STOP_PARAMETERS_APPROVED=0 `
+            "-DAPP_HMI_LINK_DIAG_ENABLED=$diag" `
+            -ITests -ITests/hmi_mocks -ITests/mocks -IAPP -IAPP/HMI -IDevice -IProtocol `
+            -IProtocol/CAN -IProtocol/HMI -IBSP/CAN -IBSP/HMI_UART -IBSP/DEBUG_UART -IBSP/SYSTEM `
+            Tests/test_hmi_snapshot_freshness.c APP/HMI/app_hmi_state.c `
+            Protocol/HMI/hmi_modbus_slave.c -o $binary
+        if ($LASTEXITCODE -ne 0) { throw "HMI快照期限测试编译失败" }
+        & $binary
+        if ($LASTEXITCODE -ne 0) { throw "HMI快照期限测试失败" }
+    }
+}
+finally { Pop-Location }
diff --git a/Tests/test_hmi_snapshot_freshness.c b/Tests/test_hmi_snapshot_freshness.c
new file mode 100644
index 0000000000000000000000000000000000000000..6b7edaca4598abbb856d695d4d52e03e9aa3d8bc
--- /dev/null
+++ b/Tests/test_hmi_snapshot_freshness.c
@@ -0,0 +1,208 @@
+/* Production snapshot/parser/UART with controllable encoder preemption. */
+#include "app_hmi_state.h"
+static void delayed_full_build(const hmi_state_input_t *in, hmi_alarm_state_t *alarm,
+                               uint16_t *registers);
+static void delayed_control_build(const hmi_state_input_t *in, uint16_t *registers);
+#define app_hmi_state_build delayed_full_build
+#define app_hmi_state_build_control delayed_control_build
+#define TEST_HMI_READ_SOURCE_HOOK
+#define main existing_hmi_integration_main
+#include "test_hmi_integration.c"
+#undef main
+#undef app_system_snapshot_read_with_meta
+#undef app_hmi_state_build
+#undef app_hmi_state_build_control
+
+static uint32_t full_delay_us, critical_delay_us, full_calls, critical_calls;
+static uint8_t require_response_before_full, saw_response_before_full;
+static uint8_t publish_after_failed_read;
+static uint8_t test_hmi_source_read(app_system_snapshot_t *snapshot,
+    uint32_t *source_ms, uint32_t *sequence, uint32_t *source_age_ms,
+    uint8_t *initialized)
+{
+    uint8_t valid = app_system_snapshot_read_with_meta(snapshot,
+        source_ms, sequence, source_age_ms, initialized);
+    if (!valid && publish_after_failed_read)
+    {
+        publish_after_failed_read = 0U;
+        app_system_snapshot_service();
+    }
+    return valid;
+}
+
+static void delayed_full_build(const hmi_state_input_t *in, hmi_alarm_state_t *alarm,
+                               uint16_t *registers)
+{
+    full_calls++;
+    if (require_response_before_full)
+    {
+        assert(response_size > 5U && response[1] == 3U);
+        saw_response_before_full = 1U;
+    }
+    app_hmi_state_build(in, alarm, registers);
+    if (full_delay_us) advance(full_delay_us);
+}
+static void delayed_control_build(const hmi_state_input_t *in, uint16_t *registers)
+{
+    critical_calls++;
+    app_hmi_state_build_control(in, registers);
+    if (critical_delay_us) advance(critical_delay_us);
+}
+static void clock_at(uint32_t ms)
+{
+    tick = ms; simulated_us = (uint64_t)ms * 1000U;
+}
+
+static void delayed_cache_test(void)
+{
+    uint16_t values[96];
+    app_hmi_snapshot_diag_t before, after;
+    hmi_alarm_state_t alarm_before;
+    fresh(); clock_at(1000U); app_system_snapshot_init();
+    clock_at(1010U); full_delay_us = 45000U; app_hmi_snapshot_init(identity_id);
+    assert(tick == 1055U);
+    app_hmi_snapshot_diag_read(&before);
+    assert(before.full_source_ms == 1000U && before.last_full_cycles == 45000U);
+    full_delay_us = 0U;
+    clock_at(1091U); app_system_snapshot_service(); clock_at(1101U);
+    memcpy(&alarm_before, &s_alarm, sizeof(s_alarm));
+    assert(app_hmi_snapshot_read(0x0460U, 96U, values));
+    assert(values[6] == 0U && values[7] == 1091U);
+    app_hmi_snapshot_diag_read(&after);
+    assert(after.critical_source_ms == 1091U && after.full_source_ms == 1000U);
+    assert(after.full_sequence == before.full_sequence);
+    assert(after.critical_sequence > after.full_sequence);
+    assert(memcmp(&alarm_before, &s_alarm, sizeof(s_alarm)) == 0);
+    /* s_input now contains fresh critical data, but that must not redate the full cache. */
+    assert(!app_hmi_snapshot_read(0x0200U, 24U, values));
+    app_hmi_snapshot_diag_read(&after);
+    assert(after.reject.reason == APP_HMI_SNAPSHOT_FULL_CACHE_EXPIRED);
+    assert(after.reject.cache_age_ms == 101U && after.reject.source_age_ms == 10U);
+    assert(after.reject.full_sequence == before.full_sequence);
+    assert(after.reject.critical_sequence > after.reject.full_sequence);
+    /* Source-based cadence refreshes now, though completion-based cadence would skip (46ms). */
+    app_hmi_snapshot_service();
+    app_hmi_snapshot_diag_read(&after);
+    assert(after.full_source_ms == 1091U && after.full_builds == before.full_builds + 1U);
+    assert(app_hmi_snapshot_read(0x0200U, 24U, values));
+    puts("PASS delayed full cache: fresh critical read, independent full expiry, source-based cadence, pure alarm");
+}
+
+static void rejection_test(void)
+{
+    uint16_t values[96];
+    app_hmi_snapshot_diag_t first, after;
+    uint32_t calls;
+    fresh(); clock_at(2000U); app_system_snapshot_init(); app_hmi_snapshot_init(identity_id);
+    clock_at(2100U); assert(app_hmi_snapshot_read(0x0460U, 64U, values));
+    clock_at(2101U); assert(!app_hmi_snapshot_read(0x0460U, 64U, values));
+    app_hmi_snapshot_diag_read(&first);
+    assert(first.reject_pending && first.reject.reason == APP_HMI_SNAPSHOT_SOURCE_EXPIRED);
+    assert(first.reject.source_age_ms == 101U && first.reject.encode_cycles == 0U);
+    calls = critical_calls;
+    assert(!app_hmi_snapshot_read(0x04BFU, 2U, values));
+    app_hmi_snapshot_diag_read(&after);
+    assert(after.merged == 1U && memcmp(&after.reject, &first.reject, sizeof(first.reject)) == 0);
+    app_hmi_snapshot_diag_ack_reject(first.reject.id + 1U);
+    app_hmi_snapshot_diag_read(&after); assert(after.reject_pending);
+    app_hmi_snapshot_diag_ack_reject(first.reject.id);
+    assert(!app_hmi_snapshot_read(0x0460U, 0U, values));
+    app_hmi_snapshot_diag_read(&after);
+    assert(after.reject.reason == APP_HMI_SNAPSHOT_BAD_PARAMETER && after.reject.id > first.reject.id);
+    app_hmi_snapshot_diag_ack_reject(after.reject.id);
+    assert(!app_hmi_snapshot_read(0x04BFU, 2U, values));
+    app_hmi_snapshot_diag_read(&after); assert(after.reject.reason == APP_HMI_SNAPSHOT_BAD_RANGE);
+    assert(critical_calls == calls);
+    assert(app_hmi_snapshot_read(APP_HMI_RESULT_START, APP_HMI_RESULT_REGISTERS, values));
+    assert(!unsafe_calls && !mailbox_calls);
+    puts("PASS source 100/101ms boundary, parameter/range validation, sticky first rejection and explicit ACK");
+}
+
+static void failed_read_publication_test(void)
+{
+    uint16_t values[96];
+    app_hmi_snapshot_diag_t diag;
+    uint32_t old_sequence;
+    fresh(); clock_at(4000U); app_system_snapshot_init(); app_hmi_snapshot_init(identity_id);
+    old_sequence = sys_buffer[sys_active].sequence;
+    clock_at(4101U); publish_after_failed_read = 1U;
+    assert(!app_hmi_snapshot_read(0x0460U, 64U, values));
+    app_hmi_snapshot_diag_read(&diag);
+    assert(sys_buffer[sys_active].now_ms == 4101U);
+    assert(diag.reject.reason == APP_HMI_SNAPSHOT_SOURCE_EXPIRED);
+    assert(diag.reject.source_age_ms == 101U && diag.reject.source_sequence == old_sequence);
+    app_hmi_snapshot_diag_ack_reject(diag.reject.id);
+    sys_initialized = 0U; publish_after_failed_read = 1U;
+    assert(!app_hmi_snapshot_read(0x0460U, 64U, values));
+    app_hmi_snapshot_diag_read(&diag);
+    assert(sys_initialized);
+    assert(diag.reject.reason == APP_HMI_SNAPSHOT_NO_SOURCE);
+    assert(diag.reject.source_age_ms == UINT32_MAX);
+    puts("PASS atomic failed-read metadata survives immediate Health publication, including no-source state");
+}
+
+static void preemption_test(void)
+{
+    uint16_t values[96];
+    app_hmi_snapshot_diag_t diag;
+    fresh(); clock_at(3000U); app_system_snapshot_init(); app_hmi_snapshot_init(identity_id);
+    clock_at(3099U); critical_delay_us = 2000U;
+    assert(!app_hmi_snapshot_read(0x0460U, 64U, values));
+    critical_delay_us = 0U; app_hmi_snapshot_diag_read(&diag);
+    assert(diag.reject.reason == APP_HMI_SNAPSHOT_ENCODE_EXPIRED);
+    assert(diag.reject.age_before_ms == 99U && diag.reject.age_after_ms == 101U);
+    assert(diag.reject.encode_cycles == 2000U);
+    /* Preemption published a new source, but the request never silently substitutes or retries. */
+    assert(diag.critical_source_ms == 3000U);
+    assert(app_hmi_snapshot_read(0x0460U, 64U, values));
+    assert(values[7] == 3101U);
+    puts("PASS encoding preemption: stale copied source rejected after encoding; no retry or fabricated timestamp");
+}
+
+static void request_priority_test(void)
+{
+    uint8_t frame[8];
+    uint32_t calls;
+    fresh(); advance(60000U); response_size = 0U;
+    request(frame, 0x0460U, 64U); inject(frame, 8U); boundary();
+    require_response_before_full = 1U; saw_response_before_full = 0U;
+    app_hmi_service(); require_response_before_full = 0U;
+    assert(saw_response_before_full && response_size == 133U); complete();
+    /* A partial parser frame suppresses background full work as well. */
+    advance(60000U); calls = full_calls;
+    request(frame, 0x0460U, 64U); inject(frame, 4U); idle(); app_hmi_service();
+    assert(s_length == 4U && full_calls == calls);
+    inject(frame + 4U, 4U); flush(); assert(response_size == 133U); complete();
+    puts("PASS queued and partial request priority over full background encoding");
+}
+
+static void tx_completion_test(void)
+{
+    uint8_t frame[8];
+    uint32_t captured, expected, saved;
+    fresh(); request(frame, 0x0460U, 64U); inject(frame, 8U); boundary();
+    app_hmi_service(); captured = s_tx_request_cycles;
+    advance(12000U); expected = test_dwt.CYCCNT - captured; complete();
+    assert(s_diag.response_complete_last_cycles == expected);
+    assert(s_diag.response_complete_max_cycles == expected);
+    /* Normal uint32 arithmetic must survive a DWT wrap. */
+    fresh(); test_dwt.CYCCNT = UINT32_MAX - 3000U;
+    request(frame, 0x0460U, 64U); inject(frame, 8U); boundary(); app_hmi_service();
+    captured = s_tx_request_cycles; advance(12000U);
+    expected = test_dwt.CYCCNT - captured; complete();
+    assert(s_diag.response_complete_last_cycles == expected && expected < 50000U);
+    saved = s_diag.response_complete_last_cycles;
+    request(frame, 0x0460U, 64U); inject(frame, 8U); flush();
+    bsp_rx_generation++; advance(12000U); complete();
+    assert(s_diag.response_complete_last_cycles == saved);
+    puts("PASS request last byte to UART TC timing, DWT wrap, recovery generation isolation");
+}
+
+int main(void)
+{
+    SystemCoreClock = 1000000U;
+    delayed_cache_test(); rejection_test(); failed_read_publication_test(); preemption_test();
+    request_priority_test(); tx_completion_test();
+    printf("PASS snapshot diag sizeof=%u, no new task/buffer/allocation\n", (unsigned)sizeof(app_hmi_snapshot_diag_t));
+    return 0;
+}
